<?xml version="1.0" encoding="utf-8"?>
<!-- openFit launcher foreground: a GPS-style route arc with start/end markers. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- route -->
    <path
        android:pathData="M38,74 C30,58 36,42 52,38 C62,35 70,38 74,45"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- start point -->
    <path
        android:pathData="M38,74 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0"
        android:fillColor="#9BE15D" />

    <!-- end point -->
    <path
        android:pathData="M74,45 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#FF6D3A" />
</vector>
